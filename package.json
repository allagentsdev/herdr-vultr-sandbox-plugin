{
  "name": "herdr-vultr-sandbox-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent Linux Vultr workers for Herdr",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run verify:manifest && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "test": "node --test test/*.test.mjs",
    "test:herdr": "node scripts/test-herdr-integration.mjs",
    "test:codex-bootstrap": "node scripts/test-codex-bootstrap.mjs",
    "test:synthetic": "npm test && npm run test:herdr",
    "test:live": "node scripts/live-conformance.mjs",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "@iarna/toml": "2.2.5"
  },
  "files": [
    "src",
    "herdr-plugin.toml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "scripts",
    "examples"
  ]
}
